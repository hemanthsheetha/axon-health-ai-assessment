[
  {"q": "How many residents are in each status?",
   "expect": {"kind": "spec", "metric": "count_residents", "dimensions": ["current_status"]}},
  {"q": "How many referrals per month in 2025?",
   "expect": {"kind": "spec", "metric": "count_residents", "dimensions": ["referral_month"],
              "time_window": ["referral_date", "2025-01-01", "2025-12-31"]}},
  {"q": "What was the median length of stay by discharge reason in 2025?",
   "expect": {"kind": "spec", "metric": "median_los_days", "dimensions": ["discharge_reason"],
              "time_window": ["discharge_date", "2025-01-01", "2025-12-31"]}},
  {"q": "How many residents were referred in 2025?",
   "expect": {"kind": "spec", "metric": "count_residents", "dimensions": [],
              "time_window": ["referral_date", "2025-01-01", "2025-12-31"]}},
  {"q": "What % of residents were successful in 2025?",
   "expect": {"kind": "clarification", "term": "successful"}},
  {"q": "How many residents stayed sober?",
   "expect": {"kind": "clarification", "term": "sober"}},
  {"q": "How many active residents do we have?",
   "expect": {"kind": "clarification", "term": "active"}},
  {"q": "How many residents relapsed?",
   "expect": {"kind": "clarification", "term": "relapse"}},
  {"q": "What % of residents were successful in 2025?",
   "define": {"successful": "Completed the program (alumni or aftercare)"},
   "expect": {"kind": "spec", "metric": "completion_rate_pct", "dimensions": [],
              "time_window": ["discharge_date", "2025-01-01", "2025-12-31"]}},
  {"q": "How many active residents do we have?",
   "define": {"active": "Currently in the program (phase 1-3)"},
   "expect": {"kind": "spec", "metric": "count_residents", "dimensions": ["current_status"]}},
  {"q": "Show me counts by staff notes",
   "expect": {"kind": "rejected"}}
]
